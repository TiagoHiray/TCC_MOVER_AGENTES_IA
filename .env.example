# Variáveis da camada agêntica do MOVER. Copie este arquivo para .env, na raiz do repositório, e
# ajuste o que precisar (o scripts/preparar_ollama já grava as três primeiras). Valores do .env têm
# prioridade sobre o config/agentes.yaml; os argumentos --provedor/--modelo têm prioridade sobre o .env.

# Provedor do Supervisor: ollama | openai | gemini | falso
MOVER_LLM_PROVEDOR=ollama
# Modelo do provedor acima (vazio = padrão do YAML: gemma2:2b / gpt-4o-mini / gemini-2.5-flash)
MOVER_LLM_MODELO=gemma2:2b

# Ollama local (padrão)
OLLAMA_HOST=http://localhost:11434

# OpenAI
# OPENAI_API_KEY=sk-...

# Gemini (SDK google-genai)
# GOOGLE_API_KEY=...

# Só para testes com o provedor falso: atraso artificial por chamada, em segundos
# MOVER_LLM_FALSO_ATRASO_S=0.5
