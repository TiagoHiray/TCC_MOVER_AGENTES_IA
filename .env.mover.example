# Variáveis da camada agêntica do MOVER. Copie as linhas que precisar para o .env da raiz do
# repositório (o mesmo .env da POC). Valores definidos aqui têm prioridade sobre o
# config/agentes.yaml; os argumentos --provedor/--modelo têm prioridade sobre o .env.

# Provedor do Supervisor: ollama | openai | gemini | falso
MOVER_LLM_PROVEDOR=ollama
# Modelo do provedor acima (vazio = padrão do YAML: gemma2:2b / gpt-4o-mini / gemini-2.5-flash)
MOVER_LLM_MODELO=gemma2:2b

# Ollama local (padrão)
OLLAMA_HOST=http://localhost:11434

# OpenAI (mesma chave usada pela POC)
# OPENAI_API_KEY=sk-...

# Gemini (SDK google-genai)
# GOOGLE_API_KEY=...

# Ingestão ao vivo do Sensor Logger: se definido, a Push URL precisa terminar com ?token=<valor>
# MOVER_INGESTAO_TOKEN=

# Só para testes com o provedor falso: atraso artificial por chamada, em segundos
# MOVER_LLM_FALSO_ATRASO_S=0.5
